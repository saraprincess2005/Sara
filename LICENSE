import os
from pydub import AudioSegment
from pydub.utils import make_chunks

def prepara_dataset(input_file, output_folder, chunk_length_ms=5000):
    """Spezza il file vocale pulito di Tiziano Leonardi in piccoli blocchi per RVC."""
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)
        
    audio = AudioSegment.from_file(input_file)
    chunks = make_chunks(audio, chunk_length_ms)
    
    for i, chunk in enumerate(chunks):
        chunk_name = os.path.join(output_folder, f"tiziano_chunk_{i}.wav")
        # Esporta in formato WAV a 44100Hz o 48000Hz (ottimale per RVC)
        chunk.export(chunk_name, format="wav", parameters=["-ar", "44100"])
    print(f"Dataset pronto: {len(chunks)} segmenti creati.")

# Esempio di utilizzo:
# prepara_dataset("voce_isolata_tiziano.wav", "dataset_tiziano")
# 1. Estrazione delle frequenze fondamentali (Pitch Extraction)
python extract_f0_print.py logs/tiziano_model 4 rmvpe

# 2. Estrazione delle Feature (Content/Voice Identity)
python extract_feature_print.py device-id 1 0 0 logs/tiziano_model v2

# 3. Avvio del Training (Es. 200 epoche)
python train_nsf_onnx.py -e tiziano_model -sr 40k -f0 1 -bs 8 -g 0 -te 200 -se 50 -m v2
